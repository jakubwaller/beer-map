# Copy to deploy/beermap.env and fill in. NEVER commit the real file.
BEERMAP_ADMIN_USER=admin
BEERMAP_ADMIN_PW=change-me-to-a-strong-password
# Salt for the stored rate-limit key. Submitter IPs are hashed with it and never
# written to disk in the clear; a stable salt keeps rate limiting working across
# restarts. Generate with: openssl rand -hex 16
BEERMAP_IP_SALT=
# Telegram notifications for new submissions (bot token + target chat id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: override the Overpass mirrors tried (in order) by the daily rebuild.
# Defaults to overpass-api.de -> private.coffee -> kumi.systems with retry/backoff.
# BEERMAP_OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
