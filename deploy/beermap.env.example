# Copy to deploy/beermap.env and fill in. NEVER commit the real file.
BEERMAP_ADMIN_USER=admin
BEERMAP_ADMIN_PW=change-me-to-a-strong-password
# Telegram notifications via the shared Raspberry Pi channel.
# Reuse the bot token + chat_id from another Pi project
# (e.g. ~/pivalert/ip-address/check-ip-address.sh).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
